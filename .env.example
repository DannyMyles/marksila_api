# MariaDB (docker-compose.yml starts one: user mark254 / mark254_dev_pw)
DATABASE_URL="mysql://mark254:change-me@localhost:3306/mark254_commerce"
PORT=4000
# Production: listen on localhost only, behind nginx
# HOST="127.0.0.1"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Browser origins allowed to call the API directly. The frontends normally go
# through their own same-origin proxy, so this rarely matters.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Apps (Fitness, SOS, ...) and their admin keys, WhatsApp numbers, email
# branding and frontend URLs live in the App table — manage them with
#   npm run app -- list | upsert | rotate-key | set-key
# There is no global admin key any more. Website content (contact details,
# page copy, social links, email branding) is edited in each app's admin.

# Absolute path to the Fitness repo's public/images/mark254 folder (seed only)
MARK254_IMAGES_DIR="/absolute/path/to/Fitness/public/images/mark254"

# SMTP (optional). Without it, emails are logged as "skipped" (records are still saved).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@example.com"
# SMTP_PASS="an-app-password"
# MAIL_FROM="bookings@yourdomain.com"   # defaults to SMTP_USER
# Per-app mailbox (overrides the shared SMTP_* values for that app only), e.g. Gmail
# with an app password (Google Account → Security → App passwords):
# SMTP_FITNESS_HOST="smtp.gmail.com"
# SMTP_FITNESS_PORT=587
# SMTP_FITNESS_USER="you@gmail.com"
# SMTP_FITNESS_PASS="abcd efgh ijkl mnop"
# MAIL_FROM_FITNESS="you@gmail.com"
# Dev only: save rendered emails as .html/.txt when SMTP isn't configured
# MAIL_PREVIEW_DIR="./.mail-preview"

# First admin login created by `npm run seed` (random + printed once if unset)
# SEED_ADMIN_EMAIL="admin@marksila254.com"
# SEED_ADMIN_PASSWORD=""
# Fallbacks for apps that don't set notificationEmail / frontendUrl themselves:
# ADMIN_NOTIFICATION_EMAIL=""
# FRONTEND_URL="http://localhost:3000"

# YouTube gallery videos (optional). The channel is set per app (--youtube-channel).
# YOUTUBE_API_KEY="your-api-key"
