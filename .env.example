# MariaDB (docker-compose.yml starts one: user mark254 / mark254_dev_pw)
DATABASE_URL="mysql://mark254:change-me@localhost:3306/mark254_commerce"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Browser origins allowed to call the API directly. The frontends normally go
# through their own same-origin proxy, so this rarely matters.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Apps (Fitness, SOS, ...) and their admin keys, WhatsApp numbers, email
# branding and frontend URLs live in the App table — manage them with
#   npm run app -- list | upsert | rotate-key | set-key
# There is no global admin key any more.

# Absolute path to the Fitness repo's public/images/mark254 folder (seed only)
MARK254_IMAGES_DIR="/absolute/path/to/Fitness/public/images/mark254"

# SMTP (optional). Without it, order/booking alerts and verification emails are skipped.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@example.com"
# SMTP_PASS="an-app-password"
# Fallbacks for apps that don't set notificationEmail / frontendUrl themselves:
# ADMIN_NOTIFICATION_EMAIL=""
# FRONTEND_URL="http://localhost:3000"

# YouTube gallery videos (optional). The channel is set per app (--youtube-channel).
# YOUTUBE_API_KEY="your-api-key"
