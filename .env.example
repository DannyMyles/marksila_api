DATABASE_URL="mysql://mark254:change-me@localhost:3306/mark254_commerce"
PORT=4000
ADMIN_API_KEY="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"
# Absolute path to the Fitness Next.js repo's public/images/mark254 folder, used only by the seed script
MARK254_IMAGES_DIR="/absolute/path/to/Fitness/public/images/mark254"

# M-Pesa (Daraja). Optional — leave unset to keep using the simulated
# payment provider. Get sandbox values free at developer.safaricom.co.ke
# (create an app, use the fixed sandbox shortcode 174379 + its passkey).
# MPESA_ENV="sandbox"
# MPESA_CONSUMER_KEY="your-consumer-key"
# MPESA_CONSUMER_SECRET="your-consumer-secret"
# MPESA_SHORTCODE="174379"
# MPESA_PASSKEY="your-passkey"
# MPESA_CALLBACK_URL="https://your-public-tunnel-url"

# YouTube (channel gallery videos). Optional — leave unset to keep the
# gallery's video section returning empty. Get a free API key at
# console.cloud.google.com (enable "YouTube Data API v3", create an API key,
# restrict it to that API).
# YOUTUBE_API_KEY="your-api-key"
# YOUTUBE_CHANNEL_HANDLE="marksila254"
