generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum UserRole {
  user
  admin
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String
  username           String              @unique
  email              String              @unique
  password           String // bcrypt hash
  role               UserRole            @default(user)
  isActive           Boolean             @default(true)
  lastLogin          DateTime?
  resetToken         String?             @unique
  resetTokenExpiry   DateTime?
  emailVerified      Boolean             @default(true)
  verifyToken        String?             @unique
  verifyTokenExpiry  DateTime?
  eventRegistrations EventRegistration[]
  orders             Order[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Blog {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  excerpt          String   @db.Text
  content          String   @db.Text
  category         String
  author           String
  authorId         Int?
  readTime         String?
  imageUrl         String?  @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  views            Int      @default(0)
  likes            Int      @default(0)
  tags             String?  @db.Text // JSON-encoded string[]
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Testimonial {
  id                Int      @id @default(autoincrement())
  name              String
  role              String
  company           String?
  content           String   @db.Text
  rating            Int
  image             String? // initials fallback, e.g. "JD" — used when no photo is uploaded
  avatarColor       String   @default("#3b82f6")
  photoFilename     String?
  photoContentType  String?
  photoSize         Int?
  achievement       String? // short highlight badge, e.g. "-30kg Lost"
  featured          Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Training {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String?  @unique
  description      String   @db.Text
  features         String   @db.Text // JSON-encoded string[]
  price            String
  imageUrl         String?  @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  icon             String?
  color            String?
  popular          Boolean  @default(false)
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String       @db.Text
  price       Int // KES, whole shillings
  images      ProductImage[]
  sizes       String?      @db.Text // JSON-encoded string[] e.g. ["S","M","L","XL"]
  colors      String?      @db.Text // JSON-encoded string[] e.g. ["Black","White"]
  inStock     Boolean      @default(true)
  featured    Boolean      @default(false)
  isNew       Boolean      @default(false)
  category    Category     @relation(fields: [categoryId], references: [id])
  categoryId  Int
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(512)
  position  Int      @default(0)
  color     String?  // optional tag, e.g. "Black" — lets the shop page swap images when a matching color is selected
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId])
}

model Order {
  id              Int           @id @default(autoincrement())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String        @db.Text
  status          OrderStatus   @default(pending)
  paymentMethod   String        @default("mpesa")
  paymentStatus   PaymentStatus @default(pending)
  paymentRef      String? // e.g. stubbed M-Pesa checkoutRequestId
  paymentResultCode Int?    // raw Safaricom ResultCode from the STK callback
  paymentResultDesc String? // raw Safaricom ResultDesc from the STK callback
  // Populated from the STK callback's CallbackMetadata on a successful
  // payment (the STK Query fallback used for local/sandbox polling can't
  // supply these — Safaricom's query response has no CallbackMetadata — so
  // they stay null until a real callback lands, e.g. in production).
  mpesaPhone            String?
  mpesaAmount           Int?
  mpesaTransactionTime  DateTime?
  subtotal        Int
  total           Int
  items           OrderItem[]
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?
  name      String // snapshot at time of order
  price     Int    // snapshot at time of order
  quantity  Int
  size      String?
  color     String?

  @@index([orderId])
}

enum TicketStatus {
  pending_payment
  confirmed
  cancelled
}

model Event {
  id               Int                 @id @default(autoincrement())
  title            String
  slug             String              @unique
  description      String              @db.Text
  date             DateTime
  time             String // display string, e.g. "6:00 AM - 7:00 AM"
  location         String
  trainers         String              @db.Text // JSON-encoded string[]
  imageUrl         String?             @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  price            Int // KES, 0 = free
  maxSpots         Int
  popular          Boolean             @default(false)
  published        Boolean             @default(true)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model GalleryCategory {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?        @db.Text
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id          Int             @id @default(autoincrement())
  title       String?
  filename    String
  contentType String
  size        Int
  category    GalleryCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   DateTime        @default(now())

  @@index([categoryId])
}

model EventRegistration {
  id            Int          @id @default(autoincrement())
  ticketNumber  String       @unique
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       Int
  // Nullable + SetNull (matches Order.userId) — deleting a user shouldn't
  // delete their ticket/registration history, just detach it.
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?
  attendeeName  String
  attendeePhone String
  status        TicketStatus @default(pending_payment)
  paymentRef    String?
  paymentResultCode Int?    // raw Safaricom ResultCode from the STK callback
  paymentResultDesc String? // raw Safaricom ResultDesc from the STK callback
  // See Order.mpesaPhone/mpesaAmount/mpesaTransactionTime — same caveat
  // about the STK Query fallback not being able to populate these.
  mpesaPhone            String?
  mpesaAmount           Int?
  mpesaTransactionTime  DateTime?
  // Set the moment a door-staff scan/manual lookup successfully checks this
  // ticket in — null means "not checked in yet". Deliberately just a
  // timestamp (no separate boolean) so "checked in" and "when" are the same
  // fact, can't drift apart.
  checkedInAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}
