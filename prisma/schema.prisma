generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Orders and bookings are confirmed over WhatsApp, not paid online — the
// status is moved along by an admin once the customer has been in touch.
enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

// Recorded by an admin when money is received offline (cash, M-Pesa
// send-money, bank) — there is no online payment integration.
enum PaymentStatus {
  unpaid
  paid
}

enum UserRole {
  user
  admin
}

// One row per frontend that shares this backend (Fitness, SOS, ...). Every
// tenant-owned record carries an appId, and every request is resolved to
// exactly one App from its X-App-Key header (see src/middleware/tenant.ts),
// so data created through one app can never be read or changed through
// another. Add a new app with `npm run app -- upsert --key <key> ...`.
model App {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique @db.VarChar(40) // public identifier sent as X-App-Key
  name                 String
  // sha256 of the server-to-server admin key (x-admin-key); null = disabled
  adminKeyHash         String?  @db.Char(64)
  whatsappNumber       String?  @db.VarChar(20) // digits only, 2547XXXXXXXX
  contactEmail         String?
  contactPhone         String?
  location             String?
  notificationEmail    String? // where new order/booking alerts go
  frontendUrl          String? // base for links in emails (verify, reset, unsubscribe)
  youtubeChannelHandle String?  @db.VarChar(100) // gallery videos; null = none
  orderPrefix          String   @default("ORD") @db.VarChar(10)
  bookingPrefix        String   @default("BKG") @db.VarChar(10)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users              User[]
  blogs              Blog[]
  testimonials       Testimonial[]
  trainings          Training[]
  categories         Category[]
  products           Product[]
  orders             Order[]
  newsletter         NewsletterSubscriber[]
  events             Event[]
  eventRegistrations EventRegistration[]
  galleryCategories  GalleryCategory[]
}

model User {
  id                 Int                 @id @default(autoincrement())
  app                App                 @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId              Int
  name               String
  username           String
  email              String
  password           String // bcrypt hash
  role               UserRole            @default(user)
  isActive           Boolean             @default(true)
  lastLogin          DateTime?
  resetToken         String?             @unique
  resetTokenExpiry   DateTime?
  emailVerified      Boolean             @default(true)
  verifyToken        String?             @unique
  verifyTokenExpiry  DateTime?
  eventRegistrations EventRegistration[]
  orders             Order[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([appId, email])
  @@unique([appId, username])
  @@index([appId])
}

model Blog {
  id               Int      @id @default(autoincrement())
  app              App      @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId            Int
  title            String
  slug             String
  excerpt          String   @db.Text
  content          String   @db.Text
  category         String
  author           String
  authorId         Int?
  readTime         String?
  imageUrl         String?  @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  views            Int      @default(0)
  likes            Int      @default(0)
  tags             String?  @db.Text // JSON-encoded string[]
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([appId, slug])
  @@index([appId])
}

model Testimonial {
  id               Int      @id @default(autoincrement())
  app              App      @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId            Int
  name             String
  role             String
  company          String?
  content          String   @db.Text
  rating           Int
  image            String? // initials fallback, e.g. "JD" — used when no photo is uploaded
  avatarColor      String   @default("#3b82f6")
  photoFilename    String?
  photoContentType String?
  photoSize        Int?
  achievement      String? // short highlight badge, e.g. "-30kg Lost"
  featured         Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([appId])
}

model Training {
  id               Int      @id @default(autoincrement())
  app              App      @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId            Int
  title            String
  slug             String?
  description      String   @db.Text
  features         String   @db.Text // JSON-encoded string[]
  price            String
  imageUrl         String?  @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  icon             String?
  color            String?
  popular          Boolean  @default(false)
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([appId, slug])
  @@index([appId])
}

model Category {
  id          Int       @id @default(autoincrement())
  app         App       @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId       Int
  name        String
  slug        String
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([appId, slug])
  @@index([appId])
}

model Product {
  id          Int            @id @default(autoincrement())
  app         App            @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId       Int
  name        String
  slug        String
  description String         @db.Text
  price       Int // KES, whole shillings
  images      ProductImage[]
  sizes       String?        @db.Text // JSON-encoded string[] e.g. ["S","M","L","XL"]
  colors      String?        @db.Text // JSON-encoded string[] e.g. ["Black","White"]
  inStock     Boolean        @default(true)
  featured    Boolean        @default(false)
  isNew       Boolean        @default(false)
  category    Category       @relation(fields: [categoryId], references: [id])
  categoryId  Int
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([appId, slug])
  @@index([categoryId])
  @@index([appId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String  @db.VarChar(512)
  position  Int     @default(0)
  color     String? // optional tag, e.g. "Black" — lets the shop page swap images when a matching color is selected
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId])
}

model Order {
  id              Int           @id @default(autoincrement())
  app             App           @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId           Int
  orderNumber     String        @unique
  customerName    String
  customerEmail   String?
  customerPhone   String
  shippingAddress String        @db.Text
  notes           String?       @db.Text
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(unpaid)
  subtotal        Int
  total           Int
  items           OrderItem[]
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([appId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  app       App      @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId     Int
  email     String
  createdAt DateTime @default(now())

  @@unique([appId, email])
  @@index([appId])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?
  name      String // snapshot at time of order
  price     Int // snapshot at time of order
  quantity  Int
  size      String?
  color     String?

  @@index([orderId])
}

enum TicketStatus {
  pending
  confirmed
  cancelled
}

model Event {
  id               Int                 @id @default(autoincrement())
  app              App                 @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId            Int
  title            String
  slug             String
  description      String              @db.Text
  date             DateTime
  time             String // display string, e.g. "6:00 AM - 7:00 AM"
  location         String
  trainers         String              @db.Text // JSON-encoded string[]
  imageUrl         String?             @db.VarChar(512)
  imageFilename    String?
  imageContentType String?
  imageSize        Int?
  price            Int // KES per person, 0 = free / price on request
  maxSpots         Int
  // Optional descriptors used by listing pages (e.g. SOS adventures).
  category         String?             @db.VarChar(60)
  difficulty       String?             @db.VarChar(40)
  duration         String?             @db.VarChar(60)
  popular          Boolean             @default(false)
  published        Boolean             @default(true)
  registrations    EventRegistration[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([appId, slug])
  @@index([appId])
}

model GalleryCategory {
  id          Int            @id @default(autoincrement())
  app         App            @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId       Int
  name        String
  slug        String
  description String?        @db.Text
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([appId, slug])
  @@index([appId])
}

model GalleryImage {
  id          Int             @id @default(autoincrement())
  title       String?
  filename    String
  contentType String
  size        Int
  category    GalleryCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdAt   DateTime        @default(now())

  @@index([categoryId])
}

model EventRegistration {
  id            Int          @id @default(autoincrement())
  app           App          @relation(fields: [appId], references: [id], onDelete: Restrict)
  appId         Int
  ticketNumber  String       @unique
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       Int
  // Nullable + SetNull (matches Order.userId) — deleting a user shouldn't
  // delete their ticket/registration history, just detach it.
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?
  attendeeName  String
  attendeePhone String
  attendeeEmail String?
  participants  Int          @default(1)
  notes         String?      @db.Text
  total         Int          @default(0) // price x participants at booking time
  status        TicketStatus @default(pending)
  // Set the moment a door-staff scan/manual lookup successfully checks this
  // ticket in — null means "not checked in yet". Deliberately just a
  // timestamp (no separate boolean) so "checked in" and "when" are the same
  // fact, can't drift apart.
  checkedInAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([appId])
}
